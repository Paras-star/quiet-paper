{
  "name": "quiet-paper",
  "install": "npm install",
  "terminals": [
    {
      "name": "server",
      "command": "npm run dev:server",
      "description": "quiet-paper API (Express) on http://localhost:3001"
    },
    {
      "name": "client",
      "command": "npm run dev:client",
      "description": "quiet-paper web client (Vite/React) on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 3001 },
    { "name": "web", "port": 5173 }
  ]
}
